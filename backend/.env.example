# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://healthflow_user:healthflow_pass@localhost:5432/healthflow_db?schema=public

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# External AI & ML Services
ML_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
